# Base URL of the Fluxora-Backend API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3000

# WebSocket endpoint used for live proposal/vote updates.
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# NOTE: Everything prefixed NEXT_PUBLIC_ is baked into the client bundle and
# is publicly visible in the browser. Never put secrets (API keys, admin
# tokens) behind a NEXT_PUBLIC_ variable.
